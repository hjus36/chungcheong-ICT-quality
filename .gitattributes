* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
# Preserve byte-level hashes recorded in dataset manifests.
*.csv -text whitespace=cr-at-eol
# Preserve the upstream source description, including its original whitespace.
*.names -text -whitespace
*.ps1 text eol=crlf
*.pdf binary
*.docx binary
*.xlsx binary
*.joblib binary

